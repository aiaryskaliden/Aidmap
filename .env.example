# Optional local settings. Copy needed entries into .env.local and keep credentials server-only.
# The catalogue, public Maple mode and Free workspace run with no .env.local file.
ADVISOR_AI_MODE=catalogue
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_LIGHT_MODEL=openai/gpt-oss-20b

# Required only for an authorized Vercel Preview demo. Use Preview-scoped secrets.
ADVISOR_DEMO_TOKEN=
ADVISOR_REDIS_REST_URL=
ADVISOR_REDIS_REST_TOKEN=

# Provider attempts and reserved tokens per 24-hour window, plus attempts per user/minute.
ADVISOR_DAILY_REQUESTS=60
ADVISOR_DAILY_TOKENS=100000
ADVISOR_USER_REQUESTS_PER_MINUTE=6

# Billing is disabled in production without all five values. Development otherwise uses a no-charge local preview.
# Set the canonical origin with no trailing slash. Local HTTP is accepted only for development with a test key.
# Configure USD recurring prices at $12/month and $84/year, and enable Stripe's hosted customer portal.
# The 32+ character cookie secret must be stable across deployments. Use a randomly generated value.
# Membership is tied to the purchasing browser. Add accounts and recovery before a public paid launch.
BILLING_APP_ORIGIN=
BILLING_COOKIE_SECRET=
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_MONTHLY_PRICE_ID=
BILLING_STRIPE_YEARLY_PRICE_ID=
